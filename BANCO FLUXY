CREATE DATABASE fluxy; 
USE fluxy; 

CREATE TABLE empresas (
id INT AUTO_INCREMENT PRIMARY KEY,
empresa VARCHAR (100) NOT NULL UNIQUE
);

CREATE TABLE setores (
id INT AUTO_INCREMENT PRIMARY KEY,
setor VARCHAR (100) NOT NULL, 
empresa_id INT NOT NULL,

FOREIGN KEY (empresa_id) REFERENCES empresas(id),
UNIQUE KEY setor_unico_por_empresa (setor, empresa_id)
);

CREATE TABLE usuarios (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    usuario VARCHAR(50) NOT NULL UNIQUE,
    senha VARCHAR(255) NOT NULL,
    empresa_id INT NULL,
    setor_id INT NULL,
    sigla VARCHAR (10) NOT NULL,
    perfil ENUM('administrador', 'admin_empresa', 'funcionario') NOT NULL,

    FOREIGN KEY (empresa_id)
        REFERENCES empresas(id),

    FOREIGN KEY (setor_id)
        REFERENCES setores(id)
);

CREATE TABLE publicacoes (
	id INT AUTO_INCREMENT PRIMARY KEY, 
	usuario_id INT NOT NULL, 
	conteudo TEXT NOT NULL,
	tipo VARCHAR(50) DEFAULT 'Aviso',
	criada_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP, 
	
	FOREIGN KEY (usuario_id) 
		REFERENCES usuarios(id)
);

CREATE TABLE eventos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL,
    empresa_id INT NOT NULL,
    titulo VARCHAR(100) NOT NULL,
    data_inicio DATETIME NOT NULL,
    data_fim DATETIME NOT NULL,
    descricao TEXT,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id),
    FOREIGN KEY (empresa_id) REFERENCES empresas(id)
);
CREATE TABLE eventos_setores (
    evento_id INT,
    setor_id INT,
    PRIMARY KEY (evento_id, setor_id),
    FOREIGN KEY (evento_id) REFERENCES eventos(id) ON DELETE CASCADE,
    FOREIGN KEY (setor_id) REFERENCES setores(id) ON DELETE CASCADE
);
