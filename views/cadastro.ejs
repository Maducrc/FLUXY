<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/cadastro-user.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="/css/modal.css">

<div class="admin-layout">

    <aside class="admin-sidebar">

            <div class="admin-brand"><div class="logo"><img src="/img/logo.png" alt="Fluxy"></div>

            </div>
            
            <p class="admin-menu-label">Menu principal</p>

            <nav class="admin-nav">

                <a href="/admin">
                    <span> Visão geral</span>
                </a>

                <a href="/cadastro-empresa">
                    <span>Empresas</span>
                </a>

                <a href="/cadastro-setor">
                    <span>Setores</span>
                </a>

                <a href="/cadastro" class="active">
                    <span>Usuários</span>
                </a>

                <a href="/logout" id="btnLogout">
                    <span>Sair</span>
                </a>
            </nav>

    </aside>

    <div class="admin-main">
        <header class="admin-header">
                    <div>
                        <h1>Gerenciar Usuários</h1>
                        <p>Cadastre um novo usuário e associe-o à um setor e empresa.</p>
                    </div>
        </header>

        <main class="container-cadastro">
        <div class="card-cadastro">

            <h1>Cadastro de Usuários</h1>

            <form id="cadastroForm">

                <div class="campo-cadastro">
                    <label for="nome">Nome completo</label>
                    <input type="text" id="nome" name="nome"
                        placeholder="Digite o nome completo" required>
                </div>

                <div class="campo-cadastro">
                    <label for="usuario">Usuário</label>
                    <input type="text" id="usuario" name="usuario"
                        placeholder="Digite o nome de usuário" required>
                </div>

                <div class="campo-cadastro">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha"
                        placeholder="Crie uma senha" required>
                </div>

                <div class="campo-cadastro">
                    <label for="sigla">Sigla</label>
                    <input type="text" id="sigla" name="sigla"
                        placeholder="Ex.: MDS" maxlength="10" required>
                </div>

                <div class="campo-cadastro">
                    <label for="perfil">Perfil de acesso</label>
                    <select id="perfil" name="perfil" required>
                        <option value="">Selecione o perfil</option>
                        <option value="administrador">Administrador</option>
                        <option value="admin_empresa">Admin da Empresa</option>
                        <option value="funcionario">Funcionário</option>
                    </select>
                </div>

                <div id="div-empresa" class="campo-cadastro">
                    <label for="empresa">Empresa</label>
                    <select id="empresa" name="empresa">
                        <option value="">Selecione uma empresa</option>
                        <% empresas.forEach(empresa => { %>
                            <option value="<%= empresa.id %>">
                                <%= empresa.empresa %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div id="div-setor" class="campo-cadastro">
                    <label for="setor">Setor</label>
                    <select id="setor" name="setor" disabled>
                        <option value="">Selecione primeiro uma empresa</option>
                    </select>
                </div>

                <button type="submit" class="btn-cadastro">
                    Cadastrar Usuário
                </button>

            </form>
        </div>
        </main>

        <div class="modal-fluxy-overlay" id="modalFluxy" hidden>
            <section class="modal-fluxy" role="dialog" aria-modal="true" aria-labelledby="modalFluxyTitulo" aria-describedby="modalFluxyMensagem">
                <div class="modal-fluxy-icone" id="modalFluxyIcone">
                    <i class="bi bi-check-circle"></i>
                </div>

                <h2 id="modalFluxyTitulo">Tudo certo!</h2>
                <p id="modalFluxyMensagem">A ação foi concluída com sucesso.</p>

                <div class="modal-fluxy-acoes">
                    <button type="button" id="modalFluxyCancelar" class="modal-fluxy-cancelar" hidden>Cancelar</button>
                    <button type="button" id="modalFluxyConfirmar" class="modal-fluxy-confirmar">Ok</button>
                </div>
            </section>
        </div>
    </div>


<script src="/js/cadastro.js"></script>
<script src="/js/logout.js"></script>
