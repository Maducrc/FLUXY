<link rel="stylesheet" href="/css/cadastro-user.css">

<div class="container-cadastro"></div>

<form id="cadastroForm">

    <input type="text" id="nome" placeholder="Nome" required>

    <input type="text" id="usuario" placeholder="Usuário" required>

    <input type="password" id="senha" placeholder="Senha" required>

    <input type="text" id="sigla" placeholder="Sigla" required>

    <select id="perfil" name="perfil" class="form-select" required>
        <option value="">Selecione o perfil</option>
        <option value="administrador">Administrador</option>
        <option value="admin_empresa">Admin da Empresa</option>
        <option value="funcionario">Funcionário</option>
    </select>

    <div id="div-empresa">
        <select id="empresa" name="empresa" class="form-select">
            <option value="">Selecione uma empresa: </option>
            <% empresas.forEach(empresa => { %>
            <option value="<%= empresa.id %>"><%= empresa.empresa %></option>
            <% }); %>
        </select>
    </div>

    <div id="div-setor">
        <select id="setor" name="setor" class="form-select" disabled>
            <option value="">Selecione primeiro uma empresa</option>
        </select>
    </div>

    <button type="submit">
        Cadastrar
    </button>

</form>

<script src="/js/cadastro.js"></script>