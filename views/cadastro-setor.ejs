<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Gerenciar Setores | Fluxy</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-brand"><div class="logo"><img src="/img/logo.png" alt="Fluxy"></div>
        </div>
            <p class="admin-menu-label">Menu principal</p>
            <nav class="admin-nav">
                <a href="/admin">
                    <span> Visão geral</span>
                </a>
                <a href="/cadastro-empresa">
                    <span>Empresas</span>
                </a>
                <a href="/cadastro-setor" class="active">
                    <span>Setores</span></a>
                <a href="/cadastro"><span>Usuários</span>
                </a>
                <a href="/logout" id="btnLogout">
                    <span>Sair</span>
                </a>
            </nav>
        </aside>

        <main class="admin-main">
            <header class="admin-header">
                <div>
                    <h1>Gerenciar Setores</h1>
                    <p>Cadastre setores e vincule-os às empresas.</p>
                </div>
            </header>

            <section class="admin-section">
                <h2>Cadastrar Novo Setor</h2>
                <div class="card p-4 mb-4">
                    <form id="formSetor" class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label">Empresa</label>
                            <select id="selectEmpresa" class="form-select" required>
                                <option value="">Selecione...</option>
                                <% empresas.forEach(emp => { %>
                                    <option value="<%= emp.id %>"><%= emp.empresa %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Nome do Setor</label>
                            <input type="text" id="inputSetor" class="form-control" required>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Cadastrar</button>
                        </div>
                    </form>
                </div>
            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cadastro-setor.js"></script>
</body>
</html>