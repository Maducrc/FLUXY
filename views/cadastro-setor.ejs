
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/cadastro-setor.css">
    <link rel="stylesheet" href="/css/modal.css">

    <div class="admin-layout">

        <aside class="admin-sidebar">

            <div class="admin-brand"><div class="logo"><img src="/img/logo.png" alt="Fluxy"></div>

            </div>
            
            <p class="admin-menu-label">Menu principal</p>

            <nav class="admin-nav">

                <a href="/admin">
                    <i class="bi bi-speedometer2"></i>
                    <span> Visão geral</span>
                </a>

                <a href="/cadastro-empresa">
                    <i class="bi bi-building"></i>
                    <span>Empresas</span>
                </a>

                <a href="/cadastro-setor" class="active">
                    <i class="bi bi-diagram-3"></i>
                    <span>Setores</span>
                </a>

                <a href="/cadastro">
                    <i class="bi bi-people"></i>
                    <span>Usuários</span>
                </a>

                <a href="/logout" id="btnLogout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Sair</span>
                </a>
            </nav>

        </aside>

        <main class="admin-main">

            <header class="admin-header">
                <div>
                    <h1>Gerenciar Setores</h1>
                    <p>Cadastre setores e vincule-os às empresas.</p>
                </div>
            </header>

            <section class="admin-section">
                <h2>Cadastrar Novo Setor</h2>

                <div class="card p-4 mb-4">

                    <form id="formSetor" class="row g-3 align-items-end">
                        
                        <div class="col-md-5">
                            <label class="form-label">Empresa</label>

                            <select id="selectEmpresa" class="form-select" required>
                                <option value="">Selecione...</option>
                                <% empresas.forEach(emp => { %>
                                    <option value="<%= emp.id %>"><%= emp.empresa %></option>
                                <% }); %>
                            </select>

                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Nome do Setor</label>
                            <input type="text" id="inputSetor" class="form-control" required>
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Cadastrar</button>
                        </div>

                    </form>

                </div>

            </section>

        </main>

    <div class="modal-fluxy-overlay" id="modalFluxy" hidden>
        <section class="modal-fluxy" role="dialog" aria-modal="true" aria-labelledby="modalFluxyTitulo" aria-describedby="modalFluxyMensagem">
            <div class="modal-fluxy-icone" id="modalFluxyIcone">
                <i class="bi bi-check-circle"></i>
            </div>

            <h2 id="modalFluxyTitulo">Tudo certo!</h2>
            <p id="modalFluxyMensagem">A ação foi concluída com sucesso.</p>

            <div class="modal-fluxy-acoes">
                <button type="button" id="modalFluxyCancelar" class="modal-fluxy-cancelar" hidden>Cancelar</button>
                <button type="button" id="modalFluxyConfirmar" class="modal-fluxy-confirmar">Ok</button>
            </div>
        </section>
    </div>

    </div>

    <script src="/js/cadastro-setor.js"></script>
    <script src="/js/logout.js"></script>