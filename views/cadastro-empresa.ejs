    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/cadastro.css">
    <link rel="stylesheet" href="/css/modal.css">


    <div class="admin-layout">

        <aside class="admin-sidebar">

                <div class="admin-brand"><div class="logo"><img src="/img/logo.png" alt="Fluxy"></div>

                </div>
                
                <p class="admin-menu-label">Menu principal</p>

                <nav class="admin-nav">

                    <a href="/admin">
                        <i class="bi bi-speedometer2"></i>
                        <span> Visão geral</span>
                    </a>

                    <a href="/cadastro-empresa" class="active">
                        <i class="bi bi-building"></i>
                        <span>Empresas</span>
                    </a>

                    <a href="/cadastro-setor">
                        <i class="bi bi-diagram-3"></i>
                        <span>Setores</span>
                    </a>

                    <a href="/cadastro">
                        <i class="bi bi-people"></i>
                        <span>Usuários</span>
                    </a>
                    
                    <a href="/logout" id="btnLogout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Sair</span>
                    </a>
                </nav>

        </aside>

        <div class="admin-main">

            <header class="admin-header">
                    <div>
                        <h1>Gerenciar Empresas</h1>
                        <p>Cadastre uma nova empresa.</p>
                    </div>
            </header>

            <main class="container-cadastro">
                <div class="card-cadastro">

                    <h1>Cadastro de Empresas</h1>

                    <form id="cadastroEmpresaForm">

                        <div class="mb-3">
                            <label for="empresa" class="form-label">Nome da Empresa</label>
                            <input
                                type="text"
                                id="empresa"
                                name="empresa"
                                class="form-control"
                                placeholder="Digite o nome da sua empresa"
                                required
                            >
                        </div>

                        <button type="submit" class="btn-cadastro">
                            Cadastrar Empresa
                        </button>

                    </form>

                </div>
            </main>

        </div>

        <div class="modal-fluxy-overlay" id="modalFluxy" hidden>
            <section class="modal-fluxy" role="dialog" aria-modal="true" aria-labelledby="modalFluxyTitulo" aria-describedby="modalFluxyMensagem">
                <div class="modal-fluxy-icone" id="modalFluxyIcone">
                    <i class="bi bi-check-circle"></i>
                </div>

                <h2 id="modalFluxyTitulo">Tudo certo!</h2>
                <p id="modalFluxyMensagem">A ação foi concluída com sucesso.</p>

                <div class="modal-fluxy-acoes">
                    <button type="button" id="modalFluxyCancelar" class="modal-fluxy-cancelar" hidden>Cancelar</button>
                    <button type="button" id="modalFluxyConfirmar" class="modal-fluxy-confirmar">Ok</button>
                </div>
            </section>
        </div>
    </div>
    
    <script src="/js/cadastro-empresa.js"></script>
    <script src="/js/logout.js"></script>



