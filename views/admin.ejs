<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel ADM | Fluxy</title>

     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
     <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <div class="admin-layout">

        <!-- MENU LATERAL -->
        <aside class="admin-sidebar">

            <div class="admin-brand">
                <div class="logo">
                    <img src="/img/logo.png" alt="Fluxy">
                </div>
            </div>

            <p class="admin-menu-label">Menu principal</p>

            <nav class="admin-nav">
                <a href="/admin" class="active">
                    <span></span>
                    Visão geral
                </a>

                <a href="/cadastro-empresa">
                    <span></span>
                    Empresas e setores
                </a>

                <a href="/cadastro">
                    <span></span>
                    Usuários
                </a>
            </nav>

        </aside>

        <!-- CONTEÚDO PRINCIPAL -->
        <main class="admin-main">

            <!-- CABEÇALHO -->
            <header class="admin-header">
                <div>
                    <h1>Visão geral</h1>
                    <p>Bem-vindo ao painel administrativo do Fluxy.</p>
                </div>

                <div class="admin-user">
                    <span class="admin-user-name">
                        <% usuario.nome %>
                    </span>
                </div>
            </header>

            <!-- INDICADORES -->
            <section class="admin-stats">

                <article class="admin-stat-card">
                    <h3>Empresas cadastradas</h3>
                    <p class="stat-number"><%= totalEmpresas %></p>
                </article>

                <article class="admin-stat-card">
                    <h3>Setores cadastrados</h3>
                    <p class="stat-number"><%= totalSetores %></p>
                </article>

            </section>

            <!-- AÇÕES RÁPIDAS -->
            <section class="admin-section">
                <h2>Ações rápidas</h2>

                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <a href="/cadastro-empresa"
                           class="admin-action">

                            <div class="admin-action-icon">+</div>

                            <div>
                                <strong>Cadastrar empresa</strong>
                                <p class="mb-0 text-secondary small">
                                    Adicione uma empresa e seus setores.
                                </p>
                            </div>

                        </a>
                    </div>

                    <div class="col-12 col-md-6">
                        <a href="/cadastro"
                           class="admin-action">

                            <div class="admin-action-icon">▤</div>

                            <div>
                                <strong>Cadastrar usuário</strong>
                                <p class="mb-0 text-secondary small">
                                    Cadestre um novo usuário à uma empresa.
                                </p>
                            </div>

                        </a>
                    </div>

                </div>
            </section>

            <!--  TABELA DE EMPRESAS -->
            <section class="admin-section">
                <h2>Empresas cadastradas</h2>

                <div class="admin-table-container">
                    <table class="table admin-table">
                        <thead>
                            <tr>
                                <th>Empresa</th>
                                <th>Setores</th>
                                <th>Usuários</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (empresas.length > 0) { %>
                                <% empresas.forEach((empresa) => { %>
                                    <tr>
                                        <td>
                                            <span class="company-name">
                                                <%= empresa.empresa %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="table-count">
                                                <%= empresa.total_setores %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="table-count">
                                                <%= empresa.total_usuarios %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="empty-state">
                                        Nenhuma empresa cadastrada.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>

        </main>
    </div>

</body>
</html>