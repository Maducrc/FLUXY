<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel ADM | Fluxy</title>

     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
     <link rel="stylesheet" href="/css/admin.css">
     <link rel="stylesheet" href="/css/modal.css">

</head>
<body>

    <div class="admin-layout">

        <aside class="admin-sidebar">

            <div class="admin-brand">
                <div class="logo">
                    <img src="/img/logo.png" alt="Fluxy">
                </div>
            </div>

            <p class="admin-menu-label">Menu principal</p>

            <nav class="admin-nav">
                <a href="/admin" class="active">
                    <span> Visão geral</span>
                </a>

                <a href="/cadastro-empresa">
                    <span>Empresas e setores</span>
                </a>

                <a href="/cadastro">
                    <span>Usuários</span>
                </a>

                <a href="/logout" class="menu-item" id="btnLogout">
                    <span>Sair</span>
                </a>
            </nav>

        </aside>

        <!-- CONTEÚDO PRINCIPAL -->
        <main class="admin-main">

            <!-- CABEÇALHO -->
            <header class="admin-header">
                <div>
                    <h1>Visão geral</h1>
                    <p>Bem-vindo ao painel administrativo do Fluxy.</p>
                </div>

                <div class="admin-user">
                    <span class="admin-user-name">
                        <% usuario.nome %>
                    </span>
                </div>
            </header>

            <!-- INDICADORES -->
            <section class="admin-stats">

                <article class="admin-stat-card">
                    <h3>Empresas cadastradas</h3>
                    <p class="stat-number"><%= totalEmpresas %></p>
                </article>

                <article class="admin-stat-card">
                    <h3>Setores cadastrados</h3>
                    <p class="stat-number"><%= totalSetores %></p>
                </article>

            </section>

            <!-- AÇÕES RÁPIDAS -->
            <section class="admin-section">
                <h2>Ações rápidas</h2>

                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <a href="/cadastro-empresa"
                           class="admin-action">

                            <div class="admin-action-icon">+</div>

                            <div>
                                <strong>Cadastrar empresa</strong>
                                <p class="mb-0 text-secondary small">
                                    Adicione uma empresa e seus setores.
                                </p>
                            </div>

                        </a>
                    </div>

                    <div class="col-12 col-md-6">
                        <a href="/cadastro"
                           class="admin-action">

                            <div class="admin-action-icon">▤</div>

                            <div>
                                <strong>Cadastrar usuário</strong>
                                <p class="mb-0 text-secondary small">
                                    Cadestre um novo usuário à uma empresa.
                                </p>
                            </div>

                        </a>
                    </div>

                </div>
            </section>

            <!--  TABELA DE EMPRESAS -->
            <section class="admin-section">
                <h2>Empresas cadastradas</h2>

                <div class="admin-table-container">
                    <table class="table admin-table">
                        <thead>
                            <tr>
                                <th>Empresa</th>
                                <th>Setores</th>
                                <th>Usuários</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (empresas.length > 0) { %>
                                <% empresas.forEach((empresa) => { %>
                                    <tr>
                                        <td>
                                            <span class="company-name">
                                                <%= empresa.empresa %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="table-count">
                                                <%= empresa.total_setores %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="table-count">
                                                <%= empresa.total_usuarios %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="empty-state">
                                        Nenhuma empresa cadastrada.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>

        </main>

    </div>

     <div class="modal-fluxy-overlay" id="modalFluxy" hidden>
        <section class="modal-fluxy" role="dialog" aria-modal="true" aria-labelledby="modalFluxyTitulo" aria-describedby="modalFluxyMensagem">
            <div class="modal-fluxy-icone" id="modalFluxyIcone">
                <i class="bi bi-check-circle"></i>
            </div>

            <h2 id="modalFluxyTitulo">Tudo certo!</h2>
            <p id="modalFluxyMensagem">A ação foi concluída com sucesso.</p>

            <div class="modal-fluxy-acoes">
                <button type="button" id="modalFluxyCancelar" class="modal-fluxy-cancelar" hidden>Cancelar</button>
                <button type="button" id="modalFluxyConfirmar" class="modal-fluxy-confirmar">Ok</button>
            </div>
        </section>
    </div>

    <script src="/js/logout.js"></script>

</body>
</html>