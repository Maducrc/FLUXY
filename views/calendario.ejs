<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendário</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/inicio.css">
    <link rel="stylesheet" href="/css/variaveis.css">
    <link rel="stylesheet" href="/css/calendario.css">
</head>
<body>
    <div class="layout">
        
        <aside class="sidebar">

            <div class="logo">
                <img src="/img/logo.png" alt="Fluxy">
            </div>

            <nav class="menu">

                <a href="/dashboard" class="menu-item">
                    <i class="bi bi-house-door"></i>
                    <span>Geral</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-chat-square-text"></i>
                    <span>Acompanhamentos</span>
                </a>

                <div class="setor">

                    <a href="#" class="menu-item">
                        <i class="bi bi-diagram-3"></i>
                        <span><%= usuario.setor %></span>
                    </a>

                    <a href="/calendario" class="menu-item ativo">
                        <i class="bi bi-calendar3"></i>
                        <span>Calendário</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>Pendências</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Indicadores</span>
                    </a>

                </div>

            </nav>

            <div class="menu-final">

                 <a href="#" class="menu-item">
                        <i class="bi bi-gear"></i>
                        <span>Configurações</span>
                </a>

                 <a href="/logout" class="menu-item">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Sair</span>
                </a>

            </div>

        </aside>

        <main class="conteudo" style="flex: 1; padding: 20px;">
            <header>
                <div>
                    <h1>Calendário</h1>
                    <p>Organize eventos e prazos</p>
                </div>
            </header>
            <div id="calendario"></div>
        </main>

    </div>

    <!-- adicionar evento -->
    <div class="modal fade" id="novoEvento" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Novo Evento</h5>
                    <button type="button" id="fecharModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="formEvento">
                        <div class="titulo">
                            <label>Título do Evento</label>
                            <input type="text" id="eventoTitulo" required>
                        </div>
                        <div class="inicio">
                                <label>Data e Hora de Início</label>
                                <input type="datetime-local" id="eventoDataInicio" required>
                        </div>
                        <div class="fim">
                                <label>Data e Hora de Fim</label>
                                <input type="datetime-local" id="eventoDataFim" required>
                            </div>
                            <div class="descricao">
                                <label>Descrição</label>
                                <textarea id="eventoDescricao"></textarea>
                            </div>
                            <div class="setores-evento mt-3">
                                <label class="mb-2"><b>Visível para quais setores?</b></label>
                                
                                <div class="d-flex flex-column gap-2" style="max-height: 150px; overflow-y: auto;">
                                    <% setores.forEach(function(setor) { %>
                                        <div class="form-check">
                                            <input class="form-check-input setor-checkbox" type="checkbox" value="<%= setor.id %>" id="setor_<%= setor.id %>">
                                            <label class="form-check-label" for="setor_<%= setor.id %>">
                                                <%= setor.setor %>
                                            </label>
                                        </div>
                                    <% }); %>
                                </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" id="botaoLimpar">Limpar</button>
                    <button type="button" id="botaoSalvarEvento">Salvar</button>
                </div>
            </div>
        </div>
    </div>
        <!-- visualizar evento -->
    <div class="modal fade" id="modalVisualizarEvento" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalhes do Evento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h4 id="vizTitulo" class="mb-3"></h4>
                    <p><strong><i class="bi bi-clock"></i> Início:</strong> <span id="vizInicio"></span></p>
                    <p><strong><i class="bi bi-clock-history"></i> Fim:</strong> <span id="vizFim"></span></p>
                    <p><strong><i class="bi bi-text-paragraph"></i> Descrição:</strong></p>
                    <p id="vizDescricao" class="text-muted bg-light p-2 rounded"></p>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-danger" id="btnExcluirEvento">
                        <i class="bi bi-trash"></i> Excluir
                    </button>
                    <button type="button" class="btn btn-primary" id="btnEditarEvento">
                        <i class="bi bi-pencil"></i> Editar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    
    <script src="/js/calendario.js"></script>
</body>
</html>