    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/inicio.css">
    <link rel="stylesheet" href="/css/modal.css">

<body>

    <div class="layout">
        
        <!-- Inicio SideBar-->
        <aside class="sidebar">

            <div class="logo">
                <img src="/img/logo.png" alt="Fluxy">
            </div>

            <nav class="menu">

                <a href="#" class="menu-item ativo">
                    <i class="bi bi-house-door"></i>
                    <span>Geral</span>
                </a>

                <a href="#" class="menu-item">
                    <i class="bi bi-chat-square-text"></i>
                    <span>Acompanhamentos</span>
                </a>

                <div class="setor">

                    <a href="#" class="menu-item">
                        <i class="bi bi-diagram-3"></i>
                        <span><%= usuario.setor %></span>
                    </a>

                    <a href="/calendario" class="menu-item">
                        <i class="bi bi-calendar3"></i>
                        <span>Calendário</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-exclamation-circle"></i>
                        <span>Pendências</span>
                    </a>

                    <a href="#" class="menu-item">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Indicadores</span>
                    </a>

                </div>

            </nav>

            <div class="menu-final">

                 <a href="#" class="menu-item">
                        <i class="bi bi-gear"></i>
                        <span>Configurações</span>
                </a>

                 <a href="/logout" class="menu-item" id="btnLogout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Sair</span>
                </a>

            </div>

        </aside>
        <!-- Fim SideBar-->

        <!-- Inicio Conteúdo Principal-->
         <main class="conteudo" id="paginaGeral" data-usuario-id="<%= usuario.id %>">

            <header class="topo">

                <div>
                    <h1>Geral</h1>
                    <p>Comunicação Entre Todos os Setores</p>
                </div>

                <div class="usuario-topo">

                    <i></i>
                    <div class="avatar"> <%= usuario.sigla %></div>

                    <div>
                        <strong> <%= usuario.nome %></strong>
                        <small> <%= usuario.setor%></small>
                    </div>

                </div>
            
            </header>

            <section class="novo-comunicado">

                <div class="avatar-comunicado">
                    <%= usuario.sigla %>
                </div>

                <div class="comunicado-conteudo">

                    <textarea id="conteudoPublicacao" placeholder="Compartilhe um algo novo com todos os setores..."></textarea>

                    <div class="comunicado-acoes">

                        <div class="categoria-publicacao">
                            <label for="tipoPublicacao" id="tittle-categoria">Categoria:</label>

                            <select id="tipoPublicacao">
                                <option value="Aviso">Aviso</option>
                                <option value="Agendamento">Agendamento</option>
                                <option value="Comunicado">Comunicado</option>
                                <option value="Atualização">Atualização</option>
                            </select>
                        </div>

                        <div class="icones-comunicado">

                            <button type="button">
                                <i class="bi bi-paperclip"></i>
                            </button>

                             <button type="button">
                                <i class="bi bi-emoji-smile"></i>
                            </button>

                        </div>

                         <button id="btnPublicar" type="button" class="btn-publicar">Publicar</button>

                    </div>

                </div>

            </section>

            <section class="feed">

                <div class="feed-topo"> 

                    <h2>Feed Geral</h2>

                    <div class="filtro">
                        <label for="filtroSetor">Setor:</label>

                        <select id="filtroSetor">
                            <option value="todos">Todos os setores</option>
                        </select>

                        <label for="filtroTipo">Categoria:</label>

                        <select id="filtroTipo">
                            <option value="todos">Todas</option>
                            <option value="Aviso">Aviso</option>
                            <option value="Agendamento">Agendamento</option>
                            <option value="Comunicado">Comunicado</option>
                            <option value="Atualização">Atualização</option>
                        </select>
                    </div>

                </div>

                <div class="lista-comunicados" id="listaComunicados">

                </div>

            </section>

        </main>
        <!-- Fim conteúdo Principal-->

        <!-- Início Lateral-->
        <aside class="laretal">

            <section class="card-lateral">
                <h2>Agenda Geral</h2>
            </section>

            <section class="card-lateral">
                <h2>Pendências Entre Setores</h2>
            </section>

            <section class="card-lateral">
                <h2>Ações Rápidas</h2>
            </section>

        </aside>
        <!-- Fim Lateral -->

    </div>

    <div class="modal-fluxy-overlay" id="modalFluxy" hidden>
        <section class="modal-fluxy" role="dialog" aria-modal="true" aria-labelledby="modalFluxyTitulo" aria-describedby="modalFluxyMensagem">
            <div class="modal-fluxy-icone" id="modalFluxyIcone">
                <i class="bi bi-check-circle"></i>
            </div>

            <h2 id="modalFluxyTitulo">Tudo certo!</h2>
            <p id="modalFluxyMensagem">A ação foi concluída com sucesso.</p>

            <div class="modal-fluxy-acoes">
                <button type="button" id="modalFluxyCancelar" class="modal-fluxy-cancelar" hidden>Cancelar</button>
                <button type="button" id="modalFluxyConfirmar" class="modal-fluxy-confirmar">Ok</button>
            </div>
        </section>
    </div>

    <script src="/js/inicio.js"></script>
    <script src="/js/logout.js"></script>

</body>